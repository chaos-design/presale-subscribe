  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 4433",
    "build": "next build --turbopack",
    "start": "next start --port 4433",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:db": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm docs:check && pnpm test"
  },
  "dependencies": {
