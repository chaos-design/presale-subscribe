    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
