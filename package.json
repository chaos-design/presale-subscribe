    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
